# Firebase web app config. Copy this file to .env and fill it in from the
# Firebase console: Project settings > General > Your apps.
#
# These are NOT secrets. The web config identifies the project and is compiled
# into the published bundle by design; Firestore rules and Auth are what secure
# the data. Never put a service account key or any other real secret in a
# VITE_ variable — it would be shipped to every visitor.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to talk to the local Firebase Emulator Suite instead of the
# live project (run `firebase emulators:start` first).
VITE_USE_EMULATORS=false
