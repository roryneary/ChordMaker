rules_version = '2';

/*
 * Four places, and the split between them is the whole design.
 *
 * A user's songs, playlists and chords live under their own uid, so the path is the
 * owner of record — see ROADMAP.md §1. Nobody else is ever let in there, for
 * any reason: that one fact is what makes an unshared song private, and it is
 * why sharing a song *copies it out* to `shared` instead of opening it up.
 *
 * Usernames cannot live under a uid: a handle has to be unique across
 * everyone, and Firestore has no unique constraint, so the claim is a document
 * whose ID *is* the handle. A document id can only exist once, which is the
 * constraint, and `create` on an existing path fails — so two people racing
 * for the same name, one loses cleanly.
 *
 * Anything not named here is refused. There used to be a wildcard under
 * `users/{uid}`, which let a signed-in user keep any data of any shape under
 * their own uid on this project's bill. The price of naming things is that
 * THESE FIELD LISTS MUST BE KEPT IN STEP with `src/types/song.ts`,
 * `src/types/playlist.ts` and `src/types/myChord.ts` (and, for a chord's
 * `spec`, `src/types/chord.ts`): add a field there and not here, and every
 * save of every song is refused. The app says so (lib/syncStatus.ts), but only once it
 * has happened.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The caller really holds this handle: nobody publishes as someone else.
    function holdsHandle(handle) {
      return handle is string
        && get(/databases/$(database)/documents/usernames/$(handle)).data.uid == request.auth.uid;
    }

    /*
     * How big a song may be. The rule is four times the longest real song:
     * Bat Out of Hell runs to about 4,500 characters, so 20,000. The word list
     * is what fills a document (each word carries a 36-character id); at these
     * limits a song is still under half of the 1 MiB a document may be.
     * `src/lib/sharedSong.ts` holds the same numbers so the app can say "too
     * long" before this does.
     */
    function validMusic(s) {
      return s.title is string && s.title.size() <= 200
        // Who plays it, absent when nobody has said (src/types/song.ts). The 200
        // is `MAX_ARTIST_CHARS` in `src/lib/sharedSong.ts`.
        && (!('artist' in s) || (s.artist is string && s.artist.size() <= 200))
        && s.key is string && s.key.size() <= 100
        && s.feel is string && s.feel.size() <= 100
        && (!('capo' in s) || s.capo == null || s.capo is number)
        && s.chords is list && s.chords.size() <= 100
        && s.lyric is string && s.lyric.size() <= 20000
        && s.words is list && s.words.size() <= 5000
        && s.placements is map && s.placements.size() <= 5000;
    }

    function validSong(s, songId) {
      return s.keys().hasOnly(['id', 'title', 'artist', 'key', 'feel', 'capo', 'chords', 'lyric',
                               'words', 'placements', 'shared', 'copiedFrom', 'createdAt',
                               'updatedAt'])
        && s.id == songId
        && validMusic(s)
        && (!('shared' in s) || s.shared is map)
        && (!('copiedFrom' in s) || s.copiedFrom is map)
        && s.createdAt is number && s.updatedAt is number;
    }

    function validPlaylist(p, playlistId) {
      return p.keys().hasOnly(['id', 'name', 'items', 'createdAt', 'updatedAt'])
        && p.id == playlistId
        && p.name is string && p.name.size() <= 200
        && p.items is list && p.items.size() <= 1000
        && p.createdAt is number && p.updatedAt is number;
    }

    /*
     * One of "My chords". A song's chords are a list, and rules cannot look
     * inside a list, so this is the one place a chord's own fields are checked.
     * The name's 100 is `MAX_CHORD_NAME` in `src/lib/myChords.ts`; the editor
     * and the reducer hold to it, so a name is never a write refused for good.
     * Six strings; five frets of six strings is thirty dots; a barre a fret
     * would be five, so six. The two stamps are required, and that is also
     * what keeps the retired store's `{ id, spec }` documents from being
     * written back: see the path below.
     */
    function validChord(c, chordId) {
      return c.keys().hasOnly(['id', 'spec', 'createdAt', 'updatedAt'])
        && c.id == chordId
        && c.spec is map
        && c.spec.keys().hasOnly(['name', 'rootFret', 'fretCount', 'markers', 'dots', 'barres'])
        && c.spec.name is string && c.spec.name.size() >= 1 && c.spec.name.size() <= 100
        && c.spec.rootFret is number && c.spec.fretCount is number
        && c.spec.markers is list && c.spec.markers.size() <= 6
        && c.spec.dots is list && c.spec.dots.size() <= 30
        && c.spec.barres is list && c.spec.barres.size() <= 6
        && c.createdAt is number && c.updatedAt is number;
    }

    // The profile: the claimed handle, written by `claimUsername`.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
                    && request.resource.data.keys().hasOnly(['handle', 'display', 'updatedAt'])
                    && request.resource.data.handle is string
                    && request.resource.data.handle.size() <= 24
                    && request.resource.data.display is string
                    && request.resource.data.display.size() <= 24;

      match /songs/{songId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validSong(request.resource.data, songId);
      }

      match /playlists/{playlistId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validPlaylist(request.resource.data, playlistId);
      }

      // "My chords" (README, "My chords"). This path was the retired
      // loose-chord store's, and its documents may still be here: bare
      // `{ id, spec }`, no stamps. They can be read and cleared, the app
      // ignores them, and `validChord` will not let one be written again.
      match /chords/{chordId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validChord(request.resource.data, chordId);
      }
    }

    match /usernames/{handle} {
      // Readable by anyone signed in: this is the availability check, and
      // the lookup that turns a handle into a uid.
      allow read: if request.auth != null;

      // Claim only what is free, only for yourself, and only a handle that
      // matches the normalised form the client promises to send. Validating
      // the shape here as well as in `lib/username.ts` means a hand-rolled
      // write cannot squat `Admin`, a 200-character name, or someone else's.
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'display', 'claimedAt'])
                    && handle.matches('^[a-z0-9][a-z0-9_.]{1,23}$')
                    && request.resource.data.display is string
                    && request.resource.data.display.size() <= 24;

      // A handle is released by its owner, never edited: renaming is a delete
      // and a fresh claim, so the id and the uid inside it can never disagree.
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    /*
     * A shared song: a copy its owner put where others can reach it.
     *
     * `get` is open to anyone, signed in or not — the id is an unguessable
     * UUID and the link carrying it is the key, so a bandmate can open a song
     * without an account. `list` is closed to everyone: there is no way to
     * find a shared song except to be handed its link, or for its owner to
     * have put a card for it in `sharedIndex` below. Unlisted, then, not
     * private — anyone given the link can read it, until the owner deletes it.
     */
    match /shared/{shareId} {
      function validShared(d) {
        return d.keys().hasOnly(['ownerUid', 'handle', 'display', 'songId', 'version', 'song',
                                 'publishedAt', 'updatedAt'])
          && d.ownerUid == request.auth.uid
          && holdsHandle(d.handle)
          && d.display is string && d.display.size() <= 24
          && d.songId is string
          && d.version is int
          && d.song is map
          && d.song.keys().hasOnly(['title', 'artist', 'key', 'feel', 'capo', 'chords', 'lyric',
                                    'words', 'placements'])
          && validMusic(d.song)
          && d.publishedAt is number && d.updatedAt is number;
      }

      allow get: if true;
      allow list: if false;

      allow create: if request.auth != null
                    && validShared(request.resource.data)
                    && request.resource.data.version == 1;

      // Its owner's, for good; and the version only ever steps forward by one,
      // because a recipient is told of changes by comparing it.
      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid
                    && validShared(request.resource.data)
                    && request.resource.data.songId == resource.data.songId
                    && request.resource.data.publishedAt == resource.data.publishedAt
                    && (request.resource.data.version == resource.data.version
                        || request.resource.data.version == resource.data.version + 1);

      // Deleting one that is already gone is allowed, as it is for its card
      // below. "Stop sharing" and deleting a song both sweep this, and the
      // owner may already have stopped from another device: refusing that
      // would leave a song that could not be deleted because its link was
      // *already* down.
      allow delete: if request.auth != null
                    && (resource == null || resource.data.ownerUid == request.auth.uid);
    }

    /*
     * The browsable library: one small card per *listed* shared song, under
     * the same id. Signed-in only. A card is written in the same batch as the
     * song it stands for, hence `getAfter` — it can only exist for a shared
     * song its writer owns, and only under the name that song carries.
     */
    match /sharedIndex/{shareId} {
      function sharedAfter() {
        return getAfter(/databases/$(database)/documents/shared/$(shareId)).data;
      }

      allow read: if request.auth != null;

      allow create, update: if request.auth != null
                    && request.resource.data.keys().hasOnly(['ownerUid', 'handle', 'display',
                         'title', 'titleLower', 'chordCount', 'firstChords', 'updatedAt'])
                    && request.resource.data.ownerUid == request.auth.uid
                    && sharedAfter().ownerUid == request.auth.uid
                    && request.resource.data.handle == sharedAfter().handle
                    && request.resource.data.display == sharedAfter().display
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.titleLower is string
                    && request.resource.data.titleLower.size() <= 200
                    && request.resource.data.chordCount is int
                    && request.resource.data.firstChords is list
                    && request.resource.data.firstChords.size() <= 4
                    && request.resource.data.updatedAt is number;

      // Deleting a card that is not there is allowed, so "stop sharing" can
      // always sweep both documents without first asking whether it was listed.
      allow delete: if request.auth != null
                    && (resource == null || resource.data.ownerUid == request.auth.uid);
    }
  }
}
